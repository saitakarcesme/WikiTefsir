{
  "name": "wikitafsir",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:sites": "vinext dev",
    "build:sites": "vinext build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "data:import:quran": "node scripts/import-tanzil-quran.mjs",
    "data:verify:quran": "node scripts/verify-quran-corpus.mjs",
    "data:import:translation:en": "node scripts/import-quranenc-english-translation.mjs",
    "data:verify:translation:en": "node scripts/verify-quranenc-english-translation.mjs",
    "data:import:hadith": "node scripts/import-hadeethenc.mjs",
    "data:verify:hadith": "node scripts/verify-hadeethenc.mjs",
    "data:verify:tafsir": "node scripts/verify-tafsir-sources.mjs",
    "data:verify:tafsir:online": "node scripts/verify-tafsir-sources.mjs --online",
    "data:verify": "npm run data:verify:quran && npm run data:verify:translation:en && npm run data:verify:hadith && npm run data:verify:tafsir"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
